{
  "name": "acme-api-client",
  "version": "2.1.0",
  "description": "ACME internal API client library",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint src/",
